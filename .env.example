# ============================================================
# .env.example — Biến môi trường cho demo-meet (Next.js frontend)
# ============================================================
# HƯỚNG DẪN:
#   1. Sao chép file này thành ".env.local" (Next.js tự đọc):
#        cp .env.example .env.local
#   2. Điền giá trị THẬT vào bên dưới
#   3. KHÔNG commit file ".env.local" lên Git (đã có trong .gitignore)
#   4. Restart `npm run dev` sau khi thay đổi env vars
#
# Ký hiệu:
#   - NEXT_PUBLIC_* : expose được ra client-side (browser) — an toàn công khai
#   - Các biến KHÔNG có prefix : server-side only (API routes)
# ============================================================

# ============================================================
# 1. RUNPOD SERVERLESS (Server upload audio từ repo Server-local)
# ============================================================
# Lấy từ RunPod Console → Serverless → Endpoint của bạn
# Khi deploy Server-local lên RunPod, copy Endpoint ID + API key vào đây

NEXT_PUBLIC_RUNPOD_API_KEY=rpa_YOUR_RUNPOD_API_KEY
NEXT_PUBLIC_RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id

# Endpoint riêng cho fine-tune model (nếu có)
RUNPOD_ENDPOINT_ID_FINE_TUNE=your_finetune_endpoint_id

# ============================================================
# 2. AI / LLM APIs
# ============================================================

# API key cho Gemini / OpenCode Go (dùng cho live summary, action items)
# Lấy tại https://opencode.ai/zen/go/v1
OPEN_CODE_GO_API_KEY=sk_your_opencode_api_key

# Deepgram (live transcription fallback)
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_PROJECT_ID=your_deepgram_project_id

# ============================================================
# 3. FIREBASE (Authentication + Storage cho audio files)
# ============================================================
# Tạo project tại https://console.firebase.google.com/
# Lấy config tại Project Settings → General → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef0123456789
NEXT_PUBLIC_FIREMENT_ID=G-XXXXXXXXXX

# Service Account Key (server-side only) - JSON string của file service-account.json
# Tải từ Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}'

# ============================================================
# 4. DATABASE (MongoDB - local hoặc Atlas)
# ============================================================

# Local MongoDB (Docker Compose)
DATABASE_URL=mongodb://admin:changeme@localhost:27017/ai_meeting?authSource=admin

# Hoặc MongoDB Atlas (cloud):
# DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/ai_meeting?retryWrites=true&w=majority

# ============================================================
# 5. EMAIL (SMTP - gửi task assignment emails)
# ============================================================
# Dùng Gmail App Password: https://myaccount.google.com/apppasswords
# KHÔNG dùng mật khẩu Gmail thường

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# ============================================================
# 6. GOOGLE OAUTH (Google Drive integration)
# ============================================================
# Tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI phải match GOOGLE_REDIRECT_URI

GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# ============================================================
# 7. MEETINGBAAS (Bot recording cho hybrid transcription)
# ============================================================
# Lấy tại https://meetingbaas.com → Dashboard → API Keys

MEETINGBAAS_API_KEY=mb_your_meetingbaas_api_key

# Webhook secret (HMAC signature verification) - optional
MEETINGBAAS_WEBHOOK_SECRET=your_webhook_secret

# ============================================================
# 8. VERCEL BLOB (Alternative storage cho audio files)
# ============================================================
# Chỉ cần nếu KHÔNG dùng Firebase Storage
# Tạo tại https://vercel.com/dashboard → Storage → Create Database

BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token
NEXT_PUBLIC_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# ============================================================
# 9. GITHUB (Tải model tự động cho fine-tune)
# ============================================================
# Personal Access Token: https://github.com/settings/tokens
# Cần scope: repo (để push code vào repo model)

GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPO=your-username/your-model-repo

# ============================================================
# 10. REALTIME PROCESSING (WebSocket server cho live recording)
# ============================================================
# Optional - chỉ cần nếu dùng tính năng live transcription qua WebSocket
# Mặc định đã có server public, chỉ cần override nếu self-host

NEXT_PUBLIC_REALTIME_PROCESSING_SERVER=wss://realtime.example.com

# ============================================================
# 11. APP URL (Cho OAuth callbacks, email links, etc.)
# ============================================================

# Public URL của app (production)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Local dev URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# 12. NODE_ENV (auto-set bởi Next.js - không cần config)
# ============================================================
# development | production | test
# Next.js tự set, nhưng có thể override nếu cần
# NODE_ENV=development